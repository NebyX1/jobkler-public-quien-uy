# Local development defaults. run.ps1/run.sh generate missing secrets in backend/.env.
APP_ENV=development
AUTH_MODE=demo
ALLOW_DEMO_AUTH=true
AI_SEARCH_ENABLED=true
AI_LLM_BASE_URL=http://127.0.0.1:8081/v1
AI_LLM_MODEL=Qwen3.5-2B-Q4_K_M.gguf
AI_SEARCH_TIMEOUT_SECONDS=20
AI_SEARCH_CONNECT_TIMEOUT_SECONDS=2
AI_SEARCH_QUEUE_WAIT_SECONDS=0.15
AI_SEARCH_RATE_LIMIT_PER_HOUR=20
AI_SEARCH_SEMANTIC_ENABLED=true
AI_SEARCH_SEMANTIC_MIN_COSINE=0.54
AI_SEARCH_EMBEDDING_THREADS=2
AI_SEARCH_DEFAULT_RESULTS=10
AI_SEARCH_MAX_RESULTS=20
AI_SEARCH_MAX_QUERY_CHARS=500
AI_SEARCH_ENCODER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
AI_SEARCH_ENCODER_REVISION=faf4aa4225822f3bc6376869cb1164e8e3feedd0
AI_SEARCH_ENCODER_CACHE=
APP_HOST=127.0.0.1
APP_PORT=5000
DATABASE_URL=sqlite:///jobkler-demo.sqlite3
FRONTEND_URL=http://127.0.0.1:5173
FUSIONAUTH_BASE_URL=
FUSIONAUTH_ISSUER=
FUSIONAUTH_CLIENT_ID=
FUSIONAUTH_CLIENT_SECRET=
FUSIONAUTH_GOOGLE_IDP_ID=
FUSIONAUTH_REDIRECT_URI=http://127.0.0.1:5000/api/auth/callback
AUTH_ALLOWED_REDIRECT_URLS=http://127.0.0.1:5173
AUTH_COOKIE_NAME=jobkler_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
SESSION_TTL_SECONDS=86400
SECRET_KEY=
AUTH_SESSION_SECRET=
CSRF_SECRET=
